	},
	"keywords": [
		"obsidian-plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"tsx": "^4.20.5",
		"typescript": "^5.8.3"
	}
}
