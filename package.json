{
	"name": "obsidian-agent-annotations",
	"version": "0.1.0",
	"description": "Write Agent instructions on Markdown selections and hand them off via current.json",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
